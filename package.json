{
	"name": "astro-sienna",
	"version": "0.4.0",
	"description": "A minimal Astro blog template — serif typography, dark mode, RSS, OG images, optional Giscus comments and analytics.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.2",
		"@astrojs/mdx": "8.0.3",
		"@astrojs/partytown": "^2.1.8",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@playform/compress": "^0.2.5",
		"astro": "7.3.8",
		"astro-expressive-code": "^0.44.2",
		"astro-icon": "^1.2.0",
		"astro-robots-txt": "^1.0.0",
		"astro-seo-schema": "^7.0.0",
		"astro-webmanifest": "^1.0.0",
		"hastscript": "^9.0.1",
		"katex": "^0.16.47",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.0",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^12.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.47.1",
		"satori-html": "^0.3.2",
		"schema-dts": "^1.1.5",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@iconify-json/mdi": "^1.2.3",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.6.1",
		"cssnano": "^9.6.0",
		"mdast-util-to-hast": "^13.2.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"rehype-unwrap-images": "^1.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.35.5",
			"svgo": "^4.1.0"
		}
	}
}
