---
import type { CollectionEntry } from "astro:content";
import ExternalIcon from "@/components/blog/ExternalIcon.astro";
import { getPostHref, getPostSortDate } from "@/data/post";
import { formatRailDate } from "@/utils/date";

interface Props {
	posts: CollectionEntry<"post">[];
	/** Seeds the `--i` stagger-animation index (e.g. when rows follow a featured post). */
	startIndex?: number;
	/** Heading tag for each post title. */
	headingLevel?: "h2" | "h3";
}

const { posts, startIndex = 0, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

{
	posts.map((p, idx) => (
		<a
			class="post"
			data-astro-prefetch
			href={getPostHref(p)}
			style={`--i: ${startIndex + idx}`}
		>
			<div class="post-rail">
				<time class="post-date" datetime={getPostSortDate(p).toISOString()}>
					{formatRailDate(getPostSortDate(p))}
				</time>
				<span class="post-dot" aria-hidden="true" />
			</div>
			<div class="post-body">
				<Heading class="post-title">
					{p.data.title}
					{p.data.externalUrl && <ExternalIcon />}
				</Heading>
				<p class="post-preview">{p.data.description}</p>
			</div>
		</a>
	))
}
