{/* Inlined to avoid FOUC — this is a parser-blocking script. */}
<script is:inline>
	(() => {
		try {
			const s = localStorage.getItem("theme");
			const d = window.matchMedia("(prefers-color-scheme: dark)").matches;
			document.documentElement.dataset.theme = s || (d ? "dark" : "light");
		} catch {}
	})();

	function syncThemeColor() {
		const meta = document.querySelector("meta[name='theme-color']");
		if (!meta) return;
		const bg = getComputedStyle(document.documentElement).getPropertyValue("--theme-bg").trim();
		if (bg) meta.setAttribute("content", `hsl(${bg})`);
	}

	addEventListener("DOMContentLoaded", () => {
		syncThemeColor();
		requestAnimationFrame(() => document.documentElement.classList.add("theme-ready"));
	});

	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function setTheme(newTheme) {
		if (newTheme !== "light" && newTheme !== "dark") return;
		document.documentElement.setAttribute("data-theme", newTheme);
		syncThemeColor();
	}

	document.addEventListener("theme-change", (e) => setTheme(e.detail.theme));
	lightModePref.addEventListener("change", (e) => {
		let stored = null;
		try { stored = localStorage.getItem("theme"); } catch {}
		if (stored) return;
		document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: e.matches ? "light" : "dark" } }));
	});
</script>
